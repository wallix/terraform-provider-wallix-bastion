# Test Environment Configuration Example
# Copy this file to .env.test and fill in your values
# DO NOT commit .env.test - it's in .gitignore

# ==============================================================================
# REQUIRED: Bastion Connection Settings
# ==============================================================================

# Bastion hostname or IP address
export WALLIX_BASTION_HOST="bastion.test.local"

# Admin username for testing
export WALLIX_BASTION_USER="admin"

# API token or password
# Recommended: Use API token instead of password
export WALLIX_BASTION_TOKEN="your-api-token-here"
# export WALLIX_BASTION_PASSWORD="your-password-here"

# ==============================================================================
# OPTIONAL: API Configuration
# ==============================================================================

# API version to test against (default: v3.8)
# Supported: v3.8, v3.12
export WALLIX_BASTION_API_VERSION="v3.12"

# HTTPS port (default: 443)
export WALLIX_BASTION_PORT="443"

# ==============================================================================
# OPTIONAL: Security Settings
# ==============================================================================

# Skip TLS certificate verification (for self-signed certificates)
# ONLY use in development/test environments!
# Default: false (verify certificates)
export WALLIX_INSECURE_SKIP_VERIFY="true"

# Enable CSRF protection (default: true)
export WALLIX_CSRF_ENABLED="true"

# Session timeout in seconds (default: 120)
export WALLIX_SESSION_TIMEOUT="120"

# ==============================================================================
# TEST CONFIGURATION
# ==============================================================================

# Enable Terraform acceptance tests
# Required for running acceptance tests with 'make testacc'
export TF_ACC="1"

# ==============================================================================
# OPTIONAL: Logging and Debugging
# ==============================================================================

# Enable Terraform debug logging
# Levels: TRACE, DEBUG, INFO, WARN, ERROR
# export TF_LOG="DEBUG"

# Log file path (if TF_LOG is set)
# export TF_LOG_PATH="./terraform-test.log"

# Enable provider debug logging
# export TF_LOG_PROVIDER="DEBUG"

# ==============================================================================
# USAGE INSTRUCTIONS
# ==============================================================================
#
# 1. Copy this file:
#    cp .env.test.example .env.test
#
# 2. Edit .env.test with your values:
#    vim .env.test  (or your preferred editor)
#
# 3. Load environment variables:
#    source .env.test
#
# 4. Verify configuration:
#    echo $WALLIX_BASTION_HOST
#
# 5. Run tests:
#    make test        # Unit tests only
#    make testacc     # Acceptance tests (requires Bastion instance)
#    make test-all    # All tests
#
# ==============================================================================
# SECURITY NOTES
# ==============================================================================
#
# - NEVER commit .env.test to version control
# - Use a dedicated test Bastion instance (not production!)
# - Create a dedicated test user with limited permissions
# - Rotate API tokens regularly
# - Use different tokens for CI/CD environments
# - Ensure .env.test is in .gitignore
#
