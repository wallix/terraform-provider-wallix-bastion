# {{ .Name }} ({{ .Type | title }})

Provides a LDAP external authentication resource.

## Example Usage

```terraform
resource "wallix-bastion_externalauth_ldap" "corporate" {
  authentication_name = "corporate_ldap"
  host                = "ldap.corporate.local"
  port                = 389
  timeout             = 10
  ldap_base           = "ou=people,dc=corporate,dc=local"
  cn_attribute        = "uid"
  login_attribute     = "uid"
  is_anonymous_access = true
}
```

### With an Authenticated Bind Account and TLS

```terraform
resource "wallix-bastion_externalauth_ldap" "corporate_secure" {
  authentication_name = "corporate_ldap_secure"
  host                = "ldap.corporate.local"
  port                = 636
  timeout             = 10
  ldap_base           = "ou=people,dc=corporate,dc=local"
  cn_attribute        = "sAMAccountName"
  login_attribute     = "sAMAccountName"
  is_active_directory = true
  is_ssl              = true
  ca_certificate      = file("${path.module}/ldap-ca.pem")
  login               = "cn=bastion,ou=service accounts,dc=corporate,dc=local"
  password            = var.ldap_bind_password
}
```

