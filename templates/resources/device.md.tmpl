# {{ .Name }} ({{ .Type | title }})

Provides a device resource.

## Example Usage

```terraform
# Configure a basic device
resource "wallix-bastion_device" "server1" {
  device_name = "server1"
  host        = "192.168.1.100"
  description = "Production web server"
}

# Configure a device with alias
resource "wallix-bastion_device" "database" {
  device_name = "db-server"
  host        = "db.example.com"
  alias       = "production-database"
  description = "Main production database server"
}

# Configure a device with tags for categorization
resource "wallix-bastion_device" "web_server" {
  device_name = "web-prod-01"
  host        = "10.0.1.50"
  description = "Production web server"

  tags {
    key   = "environment"
    value = "production"
  }

  tags {
    key   = "department"
    value = "engineering"
  }

  tags {
    key   = "os"
    value = "linux"
  }
}
```

