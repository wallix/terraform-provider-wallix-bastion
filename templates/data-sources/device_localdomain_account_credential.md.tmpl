# {{ .Name }} ({{ .Type | title }})

Get information on a credential resource for a device local domain account.

## Example Usage

```terraform
# Get information about a specific device local domain account credential
data "wallix-bastion_device_localdomain_account" "admin" {
  device_id    = wallix-bastion_device.server1.id
  domain_id    = wallix-bastion_device_localdomain.local.id
  account_name = "administrator"
}

data "wallix-bastion_device_localdomain_account_credential" "admin_ssh_key" {
  device_id  = data.wallix-bastion_device_localdomain_account.admin.device_id
  domain_id  = data.wallix-bastion_device_localdomain_account.admin.domain_id
  account_id = data.wallix-bastion_device_localdomain_account.admin.id
  type       = "ssh_key"
}

# Only public metadata is available; use the public key to verify configuration
output "admin_ssh_key_public" {
  value = {
    type       = data.wallix-bastion_device_localdomain_account_credential.admin_ssh_key.type
    public_key = data.wallix-bastion_device_localdomain_account_credential.admin_ssh_key.public_key
  }
}
```

